<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Plain http/ws to the local API; see res/xml/network_security_config.xml. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!--
          Debug-only adb bridge to the agent runtime (see AgentDebugReceiver).
          DUMP is held by the adb shell, never granted to ordinary apps.
        -->
        <receiver
            android:name=".debug.AgentDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
