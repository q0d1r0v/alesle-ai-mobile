{
  "openapi": "3.0.0",
  "paths": {
    "/v1/voice/transcribe": {
      "post": {
        "operationId": "voiceTranscribe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "audio"
                ],
                "properties": {
                  "audio": {
                    "type": "string",
                    "format": "binary",
                    "description": "AAC, M4A, WAV, OGG, MP3 or FLAC; up to 2 MB."
                  },
                  "language": {
                    "type": "string",
                    "description": "App language hint (BCP-47)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptDto"
                }
              }
            }
          },
          "503": {
            "description": "VOICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "voice"
        ]
      }
    },
    "/v1/voice/speak": {
      "post": {
        "operationId": "voiceSpeak",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reply as a WAV file.",
            "content": {
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "503": {
            "description": "VOICE_UNAVAILABLE",
            "content": {
              "audio/wav": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "voice"
        ]
      }
    },
    "/v1/health/live": {
      "get": {
        "operationId": "healthLive",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "healthReady",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE; `details` maps each dependency to up/down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Alesle AI API",
    "description": "Personal AI agent backend: auth, memory, agent tasks, billing.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SpeechLanguage": {
        "type": "string",
        "enum": [
          "en",
          "uz",
          "ru",
          "other"
        ]
      },
      "TranscriptDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "What was said, in the language and script it was said in; \"\" when nothing was understood."
          },
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SpeechLanguage"
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "text",
          "language",
          "confidence"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "RATE_LIMITED",
          "SERVICE_UNAVAILABLE",
          "VOICE_UNAVAILABLE",
          "INTERNAL"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English, for logs. Never branch on it."
          },
          "details": {
            "description": "Field issues for VALIDATION_FAILED, or string parameters for other codes.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "field",
                    "messages"
                  ]
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Echoed from X-Request-Id, or generated."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "timestamp"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "SpeakDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The reply to read aloud.",
            "maxLength": 600
          }
        },
        "required": [
          "text"
        ]
      },
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "commit": {
            "type": "string",
            "description": "Short git SHA of the running build, or \"unknown\"."
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Process uptime in whole seconds."
          }
        },
        "required": [
          "status",
          "commit",
          "uptimeSeconds"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "database": "up",
              "pgvector": "up",
              "redis": "up"
            }
          }
        },
        "required": [
          "status",
          "dependencies"
        ]
      }
    }
  }
}
