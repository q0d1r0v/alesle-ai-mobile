  "info": {
    "title": "Alesle AI API",
    "description": "Personal AI agent backend: auth, memory, agent tasks, billing.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "description": "Shown in the device list.",
            "example": "Pixel 7"
          },
          "locale": {
            "type": "string",
            "description": "App language (BCP-47) for emails.",
            "example": "uz"
          },
          "email": {
            "type": "string",
            "example": "aziz@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for the API and the agent socket."
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until accessToken expires.",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Single use: each refresh returns a new one."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken",
          "user"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "RATE_LIMITED",
          "SERVICE_UNAVAILABLE",
          "VOICE_UNAVAILABLE",
          "INVALID_CREDENTIALS",
          "EMAIL_TAKEN",
          "LINK_INVALID",
          "SESSION_EXPIRED",
          "GOOGLE_TOKEN_INVALID",
          "SIGN_IN_METHOD_UNAVAILABLE",
          "PAYMENT_PROVIDER_UNAVAILABLE",
          "INTERNAL"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English, for logs. Never branch on it."
          },
          "details": {
            "description": "Field issues for VALIDATION_FAILED, or string parameters for other codes.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "field",
                    "messages"
                  ]
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Echoed from X-Request-Id, or generated."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "timestamp"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
