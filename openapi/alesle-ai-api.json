        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "database": "up",
              "pgvector": "up",
              "redis": "up"
            }
          }
        },
        "required": [
          "status",
          "dependencies"
        ]
